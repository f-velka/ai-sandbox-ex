{
  "env": {
    "DISABLE_UPDATES": "1"
  },
  "permissions": {
    "deny": ["WebSearch"]
  },
  "disableClaudeAiConnectors": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["docker *"],
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "api.openai.com",
        "github.com"
      ]
    }
  },
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": []
}
